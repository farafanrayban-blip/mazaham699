{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mazaham699",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "29c1622b-9807-4c02-ab69-d0829a54cdf1","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f79ddb1946dc45f482048a7b55b70a4d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
